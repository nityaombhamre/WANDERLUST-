<% layout("/layouts/boilerplate") %>

<div class="container mt-5">

  <h1 class="text-center mb-4">WONDERLUST</h1>

  <div class="row">
    <% allListings.forEach(listing => { %>
      <div class="col-md-4 mb-4 d-flex"> <!-- column uses flex for equal height -->
        <div class="card show-card shadow-sm w-100">
          <img src="<%= listing.image %>" class="card-img-top show-img" alt="<%= listing.title %>">
          <div class="card-body">
            <h5 class="card-title"><%= listing.title %></h5>
            <p class="card-text">
              &#8377; <%= listing.price %> per night<br>
              <%= listing.location %>, <%= listing.country %>
            </p>
            <a href="/listings/<%= listing._id %>" class="btn btn-primary w-100">View</a>
          </div>
        </div>
      </div>
    <% }) %>
  </div>

</div>



