<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
  <div class="col-8 offset-3">
    <h3><%= listing.title || "No Title" %></h3>
  </div>

  <div class="card col-6 offset-3 show-card listing-card">
    <img
      src="<%= listing.image?.url || '/images/default.jpg' %>"
      class="card-img-top show-img"
      alt="listing_image"
    />

    <div class="card-body">
      <p class="card-text">
        Owned by
        <i><%= listing.owner ? listing.owner.username : "Unknown" %></i>
      </p>

      <p class="card-text"><%= listing.description || "No Description" %></p>

      <p class="card-text">
        Price: ₹<%= listing.price != null ?
        Number(listing.price).toLocaleString("en-IN") : "N/A" %> per night
      </p>

      <p class="card-text">Location: <%= listing.location || "N/A" %></p>
      <p class="card-text">Country: <%= listing.country || "N/A" %></p>
    </div>

    <% if (currentUser && listing.owner &&
    listing.owner._id.equals(currentUser._id)) { %>
    <div class="btns mb-2 d-flex justify-content-start gap-2 px-3">
      <a href="/listings/<%= listing._id %>/edit" class="btn btn-warning btn-sm"
        >Edit</a
      >
      <form
        method="POST"
        action="/listings/<%= listing._id %>?_method=DELETE"
        class="d-inline"
      >
        <button class="btn btn-danger btn-sm">Delete</button>
      </form>
    </div>
    <% } %>
  </div>
</div>

<hr class="mt-4" />

<!-- Reviews Section -->
<div class="row mt-3 mb-5">
  <div class="col-6 offset-3">
    <div class="card p-3 shadow-sm">
      <% if (currentUser) { %>
      <h5 class="mb-3">Add a Review</h5>
      <form
        action="/listings/<%= listing._id %>/reviews"
        method="POST"
        class="needs-validation"
        novalidate
      >
        <div class="mb-3">
          <label class="form-label">Rating</label>
          <fieldset class="starability-slot">
            <% for (let i=1; i<=5; i++) { %>
            <input
              type="radio"
              id="rate<%= i %>"
              name="review[rating]"
              value="<%= i %>"
            />
            <label for="rate<%= i %>"><%= i %> star<%= i>1?'s':'' %></label>
            <% } %>
          </fieldset>
        </div>

        <div class="mb-3">
          <label for="comment" class="form-label">Write your review</label>
          <textarea
            id="comment"
            name="review[comment]"
            class="form-control"
            rows="3"
            required
          ></textarea>
          <div class="invalid-feedback">Please enter a review comment.</div>
        </div>

        <button class="btn btn-primary btn-sm px-3">Submit Review</button>
      </form>
      <hr />
      <% } %>

      <p><b>All Reviews</b></p>
      <div class="row">
        <% for (let review of listing.reviews) { %>
        <div class="card col-5 ms-3 mb-3">
          <div class="card-body">
            <h5 class="card-title">
              <%= review.author ? review.author.username : "User" %>
            </h5>
            <p
              class="starability-result card-text"
              data-rating="<%= review.rating %>"
            ></p>
            <p class="card-text"><%= review.comment %></p>
          </div>

          <form
            method="POST"
            action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
            class="mb-3"
          >
            <button class="btn btn-sm btn-dark">Delete</button>
          </form>
        </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- Map Section -->
<div class="row mt-3 mb-5 text-center">
  <h3 class="map-title mb-3">Where you'll be</h3>

  <div
    id="map"
    style="
      width: 100%;
      max-width: 900px;
      height: 400px;
      margin: auto;
      border-radius: 10px;
    "
  ></div>
</div>

<!-- PASS TOKEN & COORDINATES -->
<script>
  window.mapToken = "<%= mapToken %>";

  // Always ensure valid lng, lat order
  const fallbackCoords = [77.2090, 28.6139];

  window.listingCoordinates =
    Array.isArray(<%- JSON.stringify(listingCoordinates) %>) &&
    <%- JSON.stringify(listingCoordinates) %>.length === 2
      ? <%- JSON.stringify(listingCoordinates) %>
      : fallbackCoords;
</script>

<!-- MAPBOX LIBRARIES -->
<link
  href="https://api.mapbox.com/mapbox-gl-js/v2.8.1/mapbox-gl.css"
  rel="stylesheet"
/>
<script src="https://api.mapbox.com/mapbox-gl-js/v2.8.1/mapbox-gl.js"></script>

<script>
  mapboxgl.accessToken = window.mapToken;

  const coords = Array.isArray(window.listingCoordinates)
    ? window.listingCoordinates
    : [77.209, 28.6139];

  const map = new mapboxgl.Map({
    container: "map",
    style: "mapbox://styles/mapbox/streets-v12",
    center: coords,
    zoom: 9,

    // 🔥 FIX: force old projection to avoid "globe" error
    projection: "mercator"
  });

  new mapboxgl.Marker({ color: "red" })
    .setLngLat(coords)
    .setPopup(new mapboxgl.Popup().setHTML(`<b><%= listing.title %></b>`))
    .addTo(map);
</script>


<style>
  .show-card img {
    width: 100%;
    height: auto;
    max-height: 25rem;
    object-fit: cover;
    border-radius: 5px;
  }

  @media (max-width: 768px) {
    .show-card {
      width: 90%;
      margin: auto;
    }
    #map {
      width: 100%;
      height: 300px;
    }
  }

  @media (max-width: 576px) {
    #map {
      height: 250px;
    }
  }
</style>
